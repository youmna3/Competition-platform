GOTRUE_DB_DRIVER=postgres
DATABASE_URL=postgres://supabase_auth_admin@127.0.0.1:54329/supa?sslmode=disable
GOTRUE_DB_MIGRATIONS_PATH=/var/tmp/stack/migrations
GOTRUE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_JWT_ADMIN_ROLES=service_role
API_EXTERNAL_URL=http://localhost:54321/auth/v1
GOTRUE_SITE_URL=http://localhost:5173
GOTRUE_URI_ALLOW_LIST=http://localhost:5173/**
GOTRUE_API_HOST=127.0.0.1
PORT=9999
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_SMTP_ADMIN_EMAIL=admin@example.com
GOTRUE_LOG_LEVEL=info
GOTRUE_RATE_LIMIT_EMAIL_SENT=1000
